{
  "info": {
    "name": "Customer Registration API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "duplicateEmail",
      "value": "existing@example.com"
    }
  ],
  "item": [
    {
      "name": "Register - success",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/customers/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "customers",
            "register"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"success-{{$timestamp}}@example.com\",\n  \"firstName\": \"Ada\",\n  \"lastName\": \"Lovelace\",\n  \"password\": \"Strong1!\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status is 201', function () { pm.response.to.have.status(201); });",
              "pm.test('response has success status', function () {",
              "  const body = pm.response.json();",
              "  pm.expect(body.status).to.eql('success');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Register - validation error",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/customers/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "customers",
            "register"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"invalid-email\",\n  \"firstName\": \"A\",\n  \"lastName\": \"B\",\n  \"password\": \"weak\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status is 400', function () { pm.response.to.have.status(400); });",
              "pm.test('error code present', function () {",
              "  const body = pm.response.json();",
              "  pm.expect(body.error.errorCode).to.exist;",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Register - duplicate email",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/customers/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "customers",
            "register"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{duplicateEmail}}\",\n  \"firstName\": \"Grace\",\n  \"lastName\": \"Hopper\",\n  \"password\": \"Strong1!\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status is 400', function () { pm.response.to.have.status(400); });",
              "pm.test('error code duplicate email', function () {",
              "  const body = pm.response.json();",
              "  pm.expect(body.error.errorCode).to.eql('DUPLICATE_EMAIL');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Register - rate limit",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/customers/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "customers",
            "register"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"rate-limit-{{$timestamp}}@example.com\",\n  \"firstName\": \"Linus\",\n  \"lastName\": \"Torvalds\",\n  \"password\": \"Strong1!\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status is not 500', function () { pm.expect(pm.response.code).to.not.eql(500); });"
            ]
          }
        }
      ]
    }
  ]
}
